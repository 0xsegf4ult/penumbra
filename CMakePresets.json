{
	"version": 5,
	"configurePresets": [
	{
		"name": "default",
		"generator" : "Ninja",
		"cacheVariables": {
			"CMAKE_CXX_FLAGS": "-stdlib=libc++ -march=native -fdiagnostics-color=always -fPIC -fno-exceptions -ffunction-sections -fno-omit-frame-pointer",
			"CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=mold -Wl,--icf=all",
			"CMAKE_SHARED_LINKER_FLAGS": "-fuse-ld=mold -Wl,--icf=all",
			"CMAKE_BUILD_TYPE": "RelWithDebInfo"
		}
	}
	]
}
