{
	"version": 5,
	"configurePresets": [
	{
		"name": "default",
		"generator" : "Ninja",
		"cacheVariables": {
			"CMAKE_EXPERIMENTAL_CXX_IMPORT_STD": "451f2fe2-a8a2-47c3-bc32-94786d8fc91b",
			"CMAKE_CXX_FLAGS": "-stdlib=libc++ -march=native -fdiagnostics-color=always -fPIC -fno-exceptions -ffunction-sections",
			"CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=mold -Wl,--icf=all",
			"CMAKE_SHARED_LINKER_FLAGS": "-fuse-ld=mold -Wl,--icf=all",
			"CMAKE_BUILD_TYPE": "RelWithDebInfo"
		}
	}
	]
}
